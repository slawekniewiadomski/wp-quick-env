# Copy this file to .env with `./bin/init` (it also fills in the real UID/GID
# and a random free port block). Keep .env out of version control.

# --- stack identity ---------------------------------------------------------
# Unique per project, so containers and volumes never collide between stacks.
COMPOSE_PROJECT_NAME=wp-quick-env

# Host user mapping. bin/init writes the real values.
HOST_UID=1000
HOST_GID=1000

# --- toolchain versions -----------------------------------------------------
# WP_VERSION + PHP_VERSION must resolve to a real Docker tag:
#   wordpress:<WP_VERSION>-php<PHP_VERSION>-apache
# https://hub.docker.com/_/wordpress/tags  |  validated by `task check`
WP_VERSION=7.1
PHP_VERSION=8.4
NODE_VERSION=24
WP_CLI_VERSION=2.12.0
COMPOSER_VERSION=2
MARIADB_VERSION=11.4
PHPMYADMIN_VERSION=5.2

# --- ports ------------------------------------------------------------------
# bin/init replaces these with a random free block: BASE, BASE+1, BASE+10.
WP_PORT=8080
PMA_PORT=8081
VITE_PORT=5173

# --- database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# --- first install (used by `task install`) ---------------------------------
WP_TITLE="WordPress Dev"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# --- theme ------------------------------------------------------------------
# Set by `task theme:clone -- <git-url>`; used by the node and composer tasks.
THEME_DIR=
