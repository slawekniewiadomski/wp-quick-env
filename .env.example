# Copy this file to .env with `./bin/init`. It asks for versions, ports and
# credentials, then fills in the real UID/GID and (by default) a random free
# port block. Keep .env out of version control.

# --- stack identity ---------------------------------------------------------
# Unique per project, so containers and volumes never collide between stacks.
COMPOSE_PROJECT_NAME=wp-quick-env

# Host user mapping. bin/init writes the real values.
HOST_UID=1000
HOST_GID=1000

# --- toolchain versions -----------------------------------------------------
# Only patched PHP branches: 8.3+ uses wordpress:<WP>-php<PHP>-apache (tracks
# upstream patch releases); below 8.3 is built from packages.sury.org, which
# rebuilds EOL branches with fixes. `bin/init` sets PHP_SOURCE from PHP_VERSION
# - update both when editing it by hand. Validated by `task check`.
WP_VERSION=7.1
PHP_VERSION=8.4
PHP_SOURCE=official
NODE_VERSION=24
WP_CLI_VERSION=2.12.0
# Composer 2.x needs PHP >= 7.2.5; use 2.2 for older branches (bin/init does).
COMPOSER_VERSION=2
MARIADB_VERSION=11.4
PHPMYADMIN_VERSION=5.2

# --- ports ------------------------------------------------------------------
# bin/init replaces these with a random free block: BASE, BASE+1, BASE+10.
WP_PORT=8080
PMA_PORT=8081
VITE_PORT=5173

# --- database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# --- first install (used by `task install`) ---------------------------------
WP_TITLE="WordPress Dev"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# --- theme ------------------------------------------------------------------
# Set by `task theme:clone -- <git-url>`; used by the node and composer tasks.
THEME_DIR=
