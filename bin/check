#!/usr/bin/env bash
# Validate the version matrix (image tags, PHP source) and port availability
# before starting the stack, so failures are one readable line instead of a raw
# pull or bind error.
#
# ENV_FILE=.env.php74 validates the multi-php stack instead of the default .env.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

export ENV_FILE="${ENV_FILE:-$ROOT/.env}"
require_env

compose=(docker compose --env-file "$ENV_FILE")

WP_VERSION="$(env_get WP_VERSION)"
PHP_VERSION="$(env_get PHP_VERSION)"
NODE_VERSION="$(env_get NODE_VERSION)"
COMPOSER_VERSION="$(env_get COMPOSER_VERSION)"
MARIADB_VERSION="$(env_get MARIADB_VERSION)"
PHPMYADMIN_VERSION="$(env_get PHPMYADMIN_VERSION)"
WP_PORT="$(env_get WP_PORT)"
PMA_PORT="$(env_get PMA_PORT)"
VITE_PORT="$(env_get VITE_PORT)"

php_source="$(env_get PHP_SOURCE || true)"
expected_source="$(php_source_for "$PHP_VERSION" || true)"
if [ -z "$expected_source" ]; then
  die "PHP $PHP_VERSION has no patched build - use one of: $PHP_BRANCHES"
fi
if [ -z "$php_source" ]; then
  if [ "$expected_source" = "sury" ]; then
    die "PHP_SOURCE is missing in $ENV_FILE - add PHP_SOURCE=sury (or run ./bin/init --force)"
  fi
  php_source="$expected_source"
fi
if [ "$php_source" != "$expected_source" ]; then
  die "PHP_SOURCE=$php_source does not match PHP $PHP_VERSION (expected $expected_source)"
fi

failures=0

image_available() {
  local image="$1"
  # Local image wins (works offline); otherwise ask the registry.
  docker image inspect "$image" >/dev/null 2>&1 ||
    docker manifest inspect "$image" >/dev/null 2>&1
}

check_image() {
  local label="$1" image="$2" hint="$3"
  if image_available "$image"; then
    printf '\033[32m✓\033[0m %-12s %s\n' "$label" "$image"
  else
    printf '\033[31m✗\033[0m %-12s %s not found\n' "$label" "$image"
    [ -n "$hint" ] && printf '    %s\n' "$hint"
    failures=$((failures + 1))
  fi
}

sury_branch_available() {
  local version="$1" count
  count="$(curl -fsSL \
    "https://packages.sury.org/php/dists/bookworm/main/binary-amd64/Packages.gz" |
    gzip -dc | grep -cE "^Package: php${version}-cli$" || true)"
  [ "${count:-0}" -gt 0 ]
}

check_sury_branch() {
  local version="$1"
  if sury_branch_available "$version"; then
    printf '\033[32m✓\033[0m %-12s php%s (packages.sury.org)\n' "php branch" "$version"
  else
    printf '\033[31m✗\033[0m %-12s php%s not in packages.sury.org\n' "php branch" "$version"
    printf '    %s\n' "Pick another branch from: $PHP_BRANCHES"
    failures=$((failures + 1))
  fi
}

info "version matrix ($ENV_FILE)"
printf '\033[32m✓\033[0m %-12s php%s (%s)\n' "php source" "$PHP_VERSION" "$(php_source_label "$php_source")"

if [ "$php_source" = "sury" ]; then
  check_image "debian" "debian:bookworm" "Base for the sury PHP build"
  check_image "wp source" "wordpress:${WP_VERSION}" \
    "Copied into the sury image - no such WordPress version"
  check_sury_branch "$PHP_VERSION"
else
  check_image "wordpress" "wordpress:${WP_VERSION}-php${PHP_VERSION}-apache" \
    "No such tag - pick a valid combination from https://hub.docker.com/_/wordpress/tags"
fi

check_image "mariadb" "mariadb:${MARIADB_VERSION}" ""
check_image "phpmyadmin" "phpmyadmin:${PHPMYADMIN_VERSION}" ""
check_image "node" "node:${NODE_VERSION}" "See https://hub.docker.com/_/node/tags"
check_image "composer" "composer:${COMPOSER_VERSION}" "See https://hub.docker.com/_/composer/tags"

if ! composer_runs_on_php "$COMPOSER_VERSION" "$PHP_VERSION"; then
  printf '\033[31m✗\033[0m %-12s Composer %s needs PHP >= 7.2.5\n' "composer" "$COMPOSER_VERSION"
  printf '    %s\n' "Use COMPOSER_VERSION=2.2 with PHP ${PHP_VERSION}"
  failures=$((failures + 1))
fi

min_php="$(wp_min_php "$WP_VERSION")"
if version_lt "$PHP_VERSION" "$min_php"; then
  warn "WordPress $WP_VERSION expects PHP >= $min_php, but PHP $PHP_VERSION is selected"
fi

printf '\n'
info "ports ($ENV_FILE)"

if "${compose[@]}" ps -q 2>/dev/null | grep -q .; then
  printf '\033[33m!\033[0m stack is running - port checks skipped\n'
else
  for spec in "WP_PORT:$WP_PORT" "PMA_PORT:$PMA_PORT" "VITE_PORT:$VITE_PORT"; do
    key="${spec%%:*}"
    port="${spec#*:}"
    if port_busy "$port"; then
      owner="$(port_owner "$port")"
      printf '\033[31m✗\033[0m %-10s %-6s in use%s\n' "$key" "$port" "${owner:+ by $owner}"
      printf '    %s\n' "Run 'task ports:new' or edit $key in $ENV_FILE"
      failures=$((failures + 1))
    else
      printf '\033[32m✓\033[0m %-10s %-6s free\n' "$key" "$port"
    fi
  done
fi

if [ "$failures" -gt 0 ]; then
  printf '\n'
  die "$failures check(s) failed"
fi

printf '\n'
ok "all checks passed"
