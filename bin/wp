#!/usr/bin/env bash
# wp-cli inside the WordPress container, running as the remapped www-data user
# so generated files stay host-owned.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"

cd "$ROOT"

if [ -z "$(docker compose ps -q wordpress 2>/dev/null)" ]; then
  printf '\033[31m✗\033[0m WordPress container is not running - start it with: task start\n' >&2
  exit 1
fi

exec docker compose exec -T -u www-data wordpress wp "$@"
